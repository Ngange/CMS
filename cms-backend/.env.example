# CMS Backend Environment Variables
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/your_db

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cms_db?retryWrites=true&w=majority

# JWT Configuration
# Generate strong secrets for production!
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-please-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-please-change-this-in-production

# JWT Expiration Times
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:4200

# File Upload Configuration
MAX_FILE_SIZE=5000000
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif

# Email Configuration (optional, for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# AWS/Cloud Storage (optional, for future use)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
